{
  "expo": {
    "name": "NiniApp",
    "slug": "mi-red-social",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/logo_app_icon.png",
    "scheme": "miredsocial",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/d85cbc5a-c975-4e6a-a2ff-1b1e12f958e6"
    },
    "runtimeVersion": "1.0.0",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.anty48.niniapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo_app_icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo_app.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "react-native-nitro-google-signin",
      [
        "expo-image-picker",
        {
          "cameraPermission": "NiniApp usa la cámara solo para tomar fotos de prueba del contador; nunca se usa sin que tú lo pidas.",
          "photosPermission": "NiniApp accede a tus fotos solo para elegir imágenes de perfil, de grupo o de prueba del contador.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_app.png",
          "imageWidth": 250,
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NiniApp usa tu ubicación solo para calcular en tu dispositivo la distancia al IFAE; nunca se envía a ningún servidor."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d85cbc5a-c975-4e6a-a2ff-1b1e12f958e6"
      }
    }
  }
}
